#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    require-prior-idle-ms = <150>;
    tapping-term-ms = <280>;
    quick-tap-ms = <250>;
    flavor = "balanced";
};

&mt {
    require-prior-idle-ms = <150>;
    tapping-term-ms = <280>;
    quick-tap-ms = <250>;
    flavor = "balanced";
};

/ {
    behaviors {
        graveesc: graveesc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;

            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bspdel: bspace_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;

            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_RCTL)>;
        };

        lt_bspdel: layer_tap_bspc_del {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_BACKSPACE_DELETE";
            #binding-cells = <2>;
            bindings = <&mo>, <&bspdel>;

            quick-tap-ms = <200>;
            tapping-term-ms = <225>;
        };

        td_lctrl_quote: td_lctrl_quote {
            compatible = "zmk,behavior-tap-dance";
            label = "DT_GUI_ENTER";
            #binding-cells = <0>;
            bindings = <&mt LEFT_CONTROL SINGLE_QUOTE>, <&kp DOUBLE_QUOTES>;
        };

        td_alt_brckt_bslsh: td_alt_brckt_bslsh {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ALT_BRCKT_BSLSH";
            #binding-cells = <0>;
            bindings =
                <&mt LEFT_ALT LEFT_BRACKET>,
                <&kp RIGHT_BRACKET>,
                <&kp BACKSLASH>;
        };

        td_alt_minus_grave_esc: td_alt_minus_grave_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ALT_MINUS_GRAVE_ESC";
            #binding-cells = <0>;
            bindings = <&mt LEFT_ALT MINUS>, <&kp GRAVE>, <&kp ESCAPE>;
        };

        lhmini: lhmini {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <30 18 6 7 19 31 45 44 46 47 48 49 35 23 11 10 22 34 33 21 9 8 20 32 0 1 2 3 4 5 12 36 50 51 52 53 54 55 56 57 42 43 39 40 13 14 15 16 17 24 38 41 29 37>;
            label = "LHMINI";
            hold-trigger-on-release;
        };

        rhmini: rhmini {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <41 29 5 17 4 3 2 1 0 12 14 16 40 28 39 38 37 36 24 25 13 26 27 15 50 51 52 53 42 6 7 8 9 10 11 23 49 55 56 57 54 43 46 45 18 19 20 21 22 35 47 30 48>;
            label = "RHMINI";
            hold-trigger-on-release;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        thumbesc {
            bindings = <&kp ESCAPE>;
            key-positions = <54 53>;
            timeout-ms = <150>;
        };

        bootloader {
            bindings = <&bootloader>;
            key-positions = <16 15 17 41>;
        };

        capsword {
            bindings = <&caps_word>;
            key-positions = <28 31>;
        };

        capslock {
            bindings = <&kp CAPS>;
            key-positions = <28 27 31 32>;
        };

        toglay_fn {
            bindings = <&tog 4>;
            key-positions = <50 52>;
        };

        toglay_rmagic {
            bindings = <&tog 1>;
            key-positions = <50 54>;
        };

        toglay_esc {
            bindings = <&to 0>;
            key-positions = <50 0>;
        };

        toglay_lmagic {
            bindings = <&tog 0>;
            key-positions = <50 53>;
        };

        toglay_num {
            bindings = <&tog 2>;
            key-positions = <50 55>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&none  &trans              &trans              &trans                  &trans                &trans                                 &trans             &trans                 &trans                  &trans              &trans                       &none
&none  &kp Q               &kp W               &kp E                   &kp R                 &kp T                                  &kp Y              &kp U                  &kp I                   &kp O               &kp P                        &none
&none  &lhmini LEFT_GUI A  &lhmini LEFT_ALT S  &lhmini LEFT_CONTROL D  &lhmini LEFT_SHIFT F  &kp G                                  &kp H              &rhmini RIGHT_SHIFT J  &rhmini LEFT_CONTROL K  &rhmini LEFT_ALT L  &rhmini RIGHT_GUI SEMICOLON  &none
&none  &kp Z               &kp X               &kp C                   &kp V                 &lt 4 B    &trans         &trans       &lt 3 N            &kp M                  &kp COMMA               &kp PERIOD          &kp SLASH                    &none
                                               &none                   &none                 &lt 5 TAB  &lt 1 ENTER    &lt 1 SPACE  &lt_bspdel 2 BSPC  &none                  &none
            >;
        };

        rmagic {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0       &bt BT_SEL 1     &bt BT_SEL 2          &bt BT_SEL 3          &bt BT_SEL 4                          &trans          &trans          &trans        &trans           &trans          &trans
&trans          &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp SYSREQ                            &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &msc SCRL_UP    &trans
&trans          &trans             &trans           &trans                &trans                &kp SCROLLLOCK                        &kp LEFT_ARROW  &kp DOWN        &kp UP_ARROW  &kp RIGHT        &trans          &trans
&bt BT_CLR_ALL  &trans             &trans           &trans                &trans                &kp PRINTSCREEN  &none     &none      &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &msc SCRL_DOWN  &trans
                                                    &trans                &trans                &trans           &trans    &mkp LCLK  &mkp RCLK       &trans          &trans
            >;
        };

        lnum {
            bindings = <
&trans  &trans     &trans        &trans        &trans        &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp GRAVE  &kp N7        &kp NUMBER_8  &kp N9        &kp N0                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp MINUS  &kp NUMBER_4  &kp N5        &kp N6        &kp EQUAL                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SQT    &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                 &trans        &trans        &trans     &trans    &trans  &trans  &trans  &trans
            >;
        };

        lnsym {
            bindings = <
&trans  &trans     &trans      &trans       &trans     &trans                               &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp TILDE  &kp AMPS    &kp ASTRK    &kp LPAR   &kp RPAR                             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp UNDER  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp PLUS                             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &kp EXCL    &kp AT       &kp HASH   &kp DOUBLE_QUOTES  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                               &trans       &trans     &trans             &trans    &trans  &trans  &trans  &trans
            >;
        };

        rfunc {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans   &trans   &trans   &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp F9  &kp F10  &kp F11  &kp F12  &kp SYSREQ       &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp F5  &kp F6   &kp F7   &kp F8   &kp SCROLLLOCK   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp PRINTSCREEN  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans   &trans
            >;
        };

        rsym {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans                &trans                 &trans          &trans     &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS       &kp EQUAL  &kp BACKSLASH  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp UNDERSCORE  &kp PLUS   &kp PIPE       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LBRC              &kp RBRC               &kp GRAVE       &kp TILDE  &kp SLASH      &trans
                        &trans  &trans  &trans  &trans    &trans  &trans                &trans                 &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        /*     num2sym { */
        /*         if-layers = <4 5>; */
        /*         then-layer = <6>; */
        /*     }; */
    };
};
