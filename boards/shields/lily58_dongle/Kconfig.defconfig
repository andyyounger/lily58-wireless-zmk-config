if SHIELD_LILY58_DONGLE

# Same name as the keyboard halves so the lily58.keymap is reused.
# Max 16 characters.
config ZMK_KEYBOARD_NAME
    default "Lily58"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# The dongle connects the left and right halves.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS + desired number of BT profiles (5)
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
